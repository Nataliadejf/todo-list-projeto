{
  "name": "todo-list-projeto",
  "version": "2.0.0",
  "description": "Planner de iniciativas com dashboard Next.js e API SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "api": "node server.js",
    "dev:web": "npm run dev --prefix web",
    "dev": "npx concurrently -k \"npm run api\" \"npm run dev:web\"",
    "build": "node scripts/build-frontend.js",
    "build:web": "npm run build --prefix web"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.16.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
